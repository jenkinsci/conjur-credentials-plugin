<org.conjur.jenkins.conjursecrets.ConjurSecretCredentialsImpl>
  <scope>GLOBAL</scope>
  <id>secret</id>
  <description>Secret variable from Conjur</description>
  <variableId>{{SECRET_PATH}}</variableId>
  <conjurConfiguration>
    <applianceURL>{{URL}}</applianceURL>
    <account>{{ACCOUNT}}</account>
    <credentialID>conjur</credentialID>
    <certificateCredentialID></certificateCredentialID>
  </conjurConfiguration>
</org.conjur.jenkins.conjursecrets.ConjurSecretCredentialsImpl>
