# ─────────────────────────────────────────────────────────────────────────────
# conjur-credentials-plugin — FIS integration test credentials
#
# Copy this file to integration-tests/.env and fill in the real values.
# The .env file is listed in .gitignore and must NEVER be committed.
#
# Format expected by the test suite:
#   CREDENTIALS=Tina:<username>:<password>
#
# The "Tina:" prefix is a convention inherited from the Python FIS e2e suite
# (CredentialManager class).  It is required — do not remove it.
# ─────────────────────────────────────────────────────────────────────────────

CREDENTIALS=Tina:<your-cyberark-identity-username>:<your-password>
