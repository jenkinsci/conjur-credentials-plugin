<settings>
  <servers>
    <server>
      <id>artifactory-central</id>
      <username>${env.ARTIFACTORY_USERNAME}</username>
      <password>${env.ARTIFACTORY_PASSWORD}</password>
    </server>
    <server>
      <id>artifactory-jenkins</id>
      <username>${env.ARTIFACTORY_USERNAME}</username>
      <password>${env.ARTIFACTORY_PASSWORD}</password>
    </server>
  </servers>
  <mirrors>
    <mirror>
      <id>artifactory-central</id>
      <mirrorOf>central</mirrorOf>
      <url>https://${env.ARTIFACTORY_HOST}/artifactory/mavencentral-remote</url>
    </mirror>
    <mirror>
      <id>artifactory-jenkins</id>
      <mirrorOf>repo.jenkins-ci.org</mirrorOf>
      <url>https://${env.ARTIFACTORY_HOST}/artifactory/jenkins-ci-releases</url>
    </mirror>
  </mirrors>
</settings>
